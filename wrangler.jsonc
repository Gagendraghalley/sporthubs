// The SportsHub website on Cloudflare Workers: static files only (the
// Flutter web build). Served at https://sporthubs.<your-subdomain>.workers.dev.
// The name must match the Worker's name in the Cloudflare dashboard, or
// Workers Builds refuses to deploy.
//
// From your computer:  scripts/deploy_web.sh
// From GitHub (Cloudflare Workers Builds): build command `bash scripts/build_web.sh`,
// deploy command `npx wrangler deploy`, and the build variables SUPABASE_URL and
// SUPABASE_ANON_KEY (README, 'Website on Cloudflare').
{
  "name": "sporthubs",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./apps/sportshub_app/build/web",
    // Pages use hash URLs (/#/gyms), so every visit loads index.html anyway.
    "not_found_handling": "single-page-application"
  }
}
