      "deviceId": "chrome",
      "toolArgs": ["--dart-define-from-file=env.json", "--web-hostname", "localhost", "--web-port", "3001"]
    },
    {
      "name": "SportsHub (phone)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/sportshub_app",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env.json"]
